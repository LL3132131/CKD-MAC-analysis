# Copy this file to config/paths.env and edit values for your system.
# Relative values are resolved from PROJECT_ROOT.
# Repository directory: root of this public code repository.
PROJECT_ROOT=.
# Repository directory: raw-data mount point; data are not committed.
DATA_RAW_DIR=${PROJECT_ROOT}/data/raw
# Repository directory: processed-data mount point; large objects are not committed.
DATA_PROCESSED_DIR=${PROJECT_ROOT}/data/processed
# Repository directory: included manuscript inputs plus externally supplied data.
# Included files are under data/manuscript_inputs; larger external resources can
# be added under data/gwas, data/GSE234356, and other documented subdirectories.
DATA_EXTERNAL_DIR=${PROJECT_ROOT}/data
# Repository directory: generated analysis outputs.
RESULTS_DIR=${PROJECT_ROOT}/results
# Repository directory: reference resources supplied by the user.
REFERENCE_DIR=${PROJECT_ROOT}/references
# External input: pySCENIC cisTarget database directory.
SCENIC_DB_DIR=${REFERENCE_DIR}/scenic_databases
# External input: human transcription-factor list used by pySCENIC.
SCENIC_TF_LIST=${REFERENCE_DIR}/scenic_databases/allTFs_hg38.txt
# External input: CREB3L2 CUT&Tag FASTQ directory.
CUTTAG_FASTQ_DIR=${DATA_RAW_DIR}/cuttag
# External input: GCST90476130 GWAS files.
GWAS_DIR=${DATA_EXTERNAL_DIR}/gwas/GCST90476130
# External input: European LD reference files.
LD_REFERENCE_DIR=${REFERENCE_DIR}/ld/eur
# Maintainer-only private input: never commit this Monocle2 object.
MONOCLE2_PRIVATE_RDS=${PROJECT_ROOT}/data/private/sub3_m2.rds
# Generated output: de-identified processed Monocle2 object used for public plotting.
MONOCLE2_PUBLIC_RDS=${DATA_PROCESSED_DIR}/sub3_m2_public.rds

# Optional module-specific locations. These defaults keep generated results
# separate while preserving the original filenames used by the scripts.
# Generated output directory: scRNA-seq atlas.
ATLAS_RESULTS_DIR=${RESULTS_DIR}/00_scRNA_atlas
# Generated output directory: SMC/OFB-SMC characterization.
SMC_RESULTS_DIR=${RESULTS_DIR}/01_SMC_OFB_characterization
# Generated output directory: CellChat.
CELLCHAT_RESULTS_DIR=${RESULTS_DIR}/02_Cell_communication
# Generated output directory: trajectory analyses.
TRAJECTORY_RESULTS_DIR=${RESULTS_DIR}/03_Trajectory
# Generated output directory: SCENIC.
SCENIC_RESULTS_DIR=${RESULTS_DIR}/04_CREB3L2_regulatory_network/scenic
# Internal handoff: generated all-cell loom used as pySCENIC input.
SCENIC_ALL_CELL_LOOM=${SCENIC_RESULTS_DIR}/00.allCell/7scenic/rSCENIC.loom
# Generated output prefix: all-cell SCENIC adjacency, regulon and AUCell files.
SCENIC_ALL_CELL_PREFIX=${SCENIC_RESULTS_DIR}/00.allCell/7scenic/pos_sce
# Internal handoff: generated SMC-enriched subset loom used as pySCENIC input.
SCENIC_SMC_LOOM=${SCENIC_RESULTS_DIR}/01.sub_allCell/sce.loom
# Generated output prefix: SMC-enriched subset SCENIC files.
SCENIC_SMC_PREFIX=${SCENIC_RESULTS_DIR}/01.sub_allCell/01.sub_allCell
# Internal handoff: generated SMC-enriched subset AUCell output.
SCENIC_SMC_AUC_LOOM=${SCENIC_SMC_PREFIX}.SCE-auc.loom
# Internal handoff: generated from SMC AUCell and consumed by Monocle2 plotting.
CREB3L2_ACTIVITY_CSV=${SCENIC_RESULTS_DIR}/01.sub_allCell/CREB3L2_activity.csv
# Generated output directory: CUT&Tag analysis.
CUTTAG_RESULTS_DIR=${RESULTS_DIR}/04_CREB3L2_regulatory_network/cuttag
# Generated output directory: experimental and external validation.
VALIDATION_RESULTS_DIR=${RESULTS_DIR}/05_Validation
# External input: downloaded/prepared GSE234356 data.
GSE234356_DIR=${DATA_EXTERNAL_DIR}/GSE234356
# External input and internal handoff directory: prepared Dynamo objects.
DYNAMO_DATA_DIR=${DATA_PROCESSED_DIR}/dynamo

# Command names can be changed when tools are installed outside PATH.
# Executable name: R command-line runner.
R_BIN=Rscript
# Executable name: Python interpreter.
PYTHON_BIN=python
# Executable name: pySCENIC.
PYSCENIC_BIN=pyscenic
# Executable name: scDRS.
SCDRS_BIN=scdrs
# Executable name: MAGMA.
MAGMA_BIN=magma
# Executable name: Bowtie2 aligner.
BOWTIE2_BIN=bowtie2
# Executable name: Bowtie2 index builder.
BOWTIE2_BUILD_BIN=bowtie2-build
# Executable name: SAMtools.
SAMTOOLS_BIN=samtools
# Executable name: Picard.
PICARD_BIN=picard
# Executable name: MACS2.
MACS2_BIN=macs2
# Executable name: BEDTools.
BEDTOOLS_BIN=bedtools
# Executable name: deepTools bamCoverage.
BAMCOVERAGE_BIN=bamCoverage
# Executable name: Trim Galore.
TRIM_GALORE_BIN=trim_galore
# Executable name: zcat.
ZCAT_BIN=zcat
# Executable name: awk.
AWK_BIN=awk
